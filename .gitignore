# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Node
node_modules/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Downloads, intermediate files, and local results stay out of version control. The human
# games in particular have no licence and must not be redistributed.
data/*
!data/.gitkeep
reports/*
!reports/.gitkeep

# Local settings
.env

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
